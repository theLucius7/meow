---
import { Icon } from "astro-icon/components";
import { getLocaleFromPath, type Locale } from "@/i18n/locales";
import { macFlareConfig, navBarConfig, siteConfig } from "../config";
import { getLinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { localeUrl, url } from "../utils/url-utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import MacFlare from "./MacFlare.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

interface Props {
	class?: string;
	alternates?: Array<{ locale: Locale; url: string }>;
}
const className = Astro.props.class;
const locale = getLocaleFromPath(Astro.url.pathname);
const alternates = Astro.props.alternates ?? [];
const presets = getLinkPresets(locale);

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return presets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between gap-1 px-2 sm:px-4"]}>
        <div class="flex min-w-0 items-center gap-1">
        <a href={localeUrl(locale)} class="btn-plain scale-animation rounded-lg h-[3.25rem] min-w-0 px-1 sm:px-3 font-bold active:scale-95">
            <div class="flex min-w-0 flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="hidden sm:block shrink-0 text-[1.75rem] mb-1 mr-2" />
                <span class="truncate">{siteConfig.title}</span>
            </div>
        </a>
        {macFlareConfig.enable && <MacFlare client:load locale={locale} baseUrl={macFlareConfig.baseUrl} />}
        </div>
        <div class="hidden lg:flex shrink-0">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : localeUrl(locale, l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-3 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="navbar-controls flex shrink-0 items-center">
            <LanguageSwitcher locale={locale} alternates={alternates} />
            <Search locale={locale} client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label={locale === "en" ? "Display settings" : "显示设置"} class="!hidden sm:!flex btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch locale={locale} client:only="svelte"></LightDarkSwitch>
            <button aria-label={locale === "en" ? "Menu" : "菜单"} name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 lg:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings locale={locale} client:only="svelte"></DisplaySettings>
    </div>
</div>

<style>
    @media (max-width: 639px) {
        .navbar-controls :global(#search-switch),
        .navbar-controls :global(#scheme-switch),
        .navbar-controls :global(#nav-menu-switch) {
            width: 2rem;
        }
    }
</style>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
